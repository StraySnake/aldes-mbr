# Copy this file to docker-compose.yml and adjust for your setup.
#
# Pre-requisites:
#   - Pi-hole (or any DNS) configured to rewrite:
#       aldesiotsuite.azure-devices.net -> <this host's IP>
#   - An MQTT broker (Mosquitto) reachable for republishing telemetry
#   - The Connect Box already paired on your WiFi
#
# DEVICE_MAC is REQUIRED. Find it via:
#   nslookup HF-LPB100      (if box on local DNS)
#   arp -a                  (look for prefix 28:9C:6E)

services:
  aldes-mbr:
    # Build the image from this repository (recommended: it always matches the code
    # you cloned). Update with: git pull && docker compose up -d --build
    build: .
    # Or use the image published by this repository's CI instead of building
    # (GitHub may keep it private until the owner makes the package public):
    # image: ghcr.io/straysnake/aldes-mbr:latest
    container_name: aldes-mbr
    restart: unless-stopped
    init: true           # forwards SIGTERM properly -> fast, clean `docker compose stop`
    logging:             # cap Docker's own log (the broker logs every telemetry frame)
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    network_mode: host   # required to see real client IP for the box
    volumes:
      - ./data:/data     # persists self-signed cert
      - ./logs:/logs
    environment:
      # === REQUIRED ===
      DEVICE_MAC: "AA:BB:CC:DD:EE:FF"

      # === Recommended: only accept the box's IP ===
      # Without it, any device on your LAN can impersonate the box (fake telemetry,
      # stealing the session). Reserve the box's IP in your DHCP server FIRST:
      # if its IP changes, the bridge refuses it ("REFUSED" in the logs).
      # DEVICE_IP: "192.168.1.50"

      # === Upstream Mosquitto (where telemetry is republished) ===
      UPSTREAM_MQTT_HOST: "127.0.0.1"
      UPSTREAM_MQTT_PORT: "1883"
      # UPSTREAM_MQTT_USER: ""
      # UPSTREAM_MQTT_PASS: ""
      # UPSTREAM_MQTT_TLS: "1"            # Mosquitto over TLS (usually port 8883)
      # UPSTREAM_MQTT_CA: "/data/ca.crt"  # CA of Mosquitto's certificate (default: system CAs)
      # UPSTREAM_MQTT_TLS_INSECURE: "1"   # self-signed, NOT verified (prefer UPSTREAM_MQTT_CA)

      # === Branding ===
      DEVICE_NAME: "Aldes VMC"
      DEVICE_MODEL: "Dee Fly Cube"

      # === Topic prefix ===
      BRIDGE_TOPIC_PREFIX: "aldes/vmc"

      # === Home Assistant MQTT discovery prefix ===
      HA_DISCOVERY_PREFIX: "homeassistant"

      # === Home Assistant behaviour ===
      # SENSOR_EXPIRE_AFTER: "1800"  # sensors unavailable after 30 min without telemetry (0 = never)
      # CMD_CONFIRM_TIMEOUT: "900"   # max wait for a frame confirming a mode change
      # CMD_QOS: "1"                 # 1 = commands acknowledged by the box (0 = legacy, not recommended)

      LOG_FILE: "/logs/mitm.log"
      # LOG_LEVEL: "info"            # debug = every telemetry frame with its payload
      # LOG_MAX_BYTES: "5242880"   # rotate mitm.log above 5 MB (0 = never)
      # LOG_BACKUPS: "3"

      # === TLS offered to the box (advanced) ===
      # The suite the box negotiates is logged at each connection ("TLS TLSv1.2 <suite>").
      # Once known, you can restrict to it, e.g.:
      # TLS_CIPHERS: "ECDHE-RSA-AES128-GCM-SHA256:@SECLEVEL=0"
